# Variables à saisir dans Portainer (stack homelab.yml → Environment variables).
# Ce fichier ne contient que des exemples : aucune vraie valeur dans le dépôt.

# Mot de passe commun à toutes les applis (12 caractères au moins)
MAISON_PASSWORD=change-moi-12-caracteres-minimum
# Jeton commun des échanges entre applis maison (Millésime lit /externe/noms avec lui)
# MAISON_JETON=un-long-jeton-commun
# « oui » : aucune appli de la maison n'écrit chez un service extérieur
# MAISON_LECTURE_SEULE=oui
# Ancien nom, encore lu en repli (0.6.0) : CHAMBRE_NOIRE_PASSWORD reçoit ${CARNET_PASSWORD} dans la stack
# CARNET_PASSWORD=change-moi-12-caracteres-minimum

# Clé d'API Immich dédiée à Chambre noire (permissions : voir l'écran Connexion)
CHAMBRE_NOIRE_IMMICH_CLE=

# Facultatif depuis 0.4.1 (réglable dans l'appli : Réglages › Noms dans Immich) — valeur de départ seulement.
# Libellé des albums et des tags : album « AAAA-MM <libellé> », tag « <libellé>/AAAA-MM ».
# Photos non datées : album « Non datées <libellé> », tag « <libellé>/Non datée ».
# Doit rester celui que lit Millésime (MILLESIME_TAG_PREFIXE, MILLESIME_ALBUM_NON_DATEES).
CHAMBRE_NOIRE_LIBELLE=Numérisation Exemple
# Facultatif : nom de l'album des non datées s'il diffère de « Non datées <libellé> »
CHAMBRE_NOIRE_ALBUM_NON_DATEES=

# Facultatif
# PORT_CHAMBRE_NOIRE=8100
# « oui » : l'appli lit tout mais n'écrit rien dans Immich (premier jour d'une nouvelle version) ;
# « non » : écrit même si MAISON_LECTURE_SEULE=oui. Vide : suit MAISON_LECTURE_SEULE.
CHAMBRE_NOIRE_LECTURE_SEULE=

# Facultatif (0.5.0) : ancien jeton partagé avec Millésime (MILLESIME_JETON_CHAMBRE_NOIRE), qui lit les noms des non datées.
# Accepté en plus de MAISON_JETON (0.6.0). Les deux vides : adresse /externe/noms fermée.
CHAMBRE_NOIRE_JETON_MILLESIME=
